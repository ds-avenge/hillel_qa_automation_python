pipeline {
    agent any

    stages {
        stage('Run tests in Docker') {
            steps {
                dir('homeworks/homeworks_30') {
                    sh '''
                        docker compose up --build --abort-on-container-exit
                    '''
                }
            }
        }
    }

    post {
        always {
            dir('homeworks/homeworks_30') {
                sh 'docker compose down'
            }

            allure([
                includeProperties: false,
                results: [[path: 'homeworks/homeworks_30/allure-results']]
            ])
        }
    }
}
